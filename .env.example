# Postgres connection used by anonymous, RLS-limited public queries.
DATABASE_URL_PUBLIC=
# Postgres connection used by authenticated app operations and jobs.
DATABASE_URL_APP=
# Postgres connection used only to run schema migrations.
DATABASE_URL_MIGRATIONS=

# Supabase project URL used by authentication.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key; safe for browser use under the project's policy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# S3-compatible storage API endpoint.
STORAGE_S3_ENDPOINT=
# S3-compatible storage region.
STORAGE_S3_REGION=
# Bucket used for application-managed files.
STORAGE_S3_BUCKET=
# S3-compatible storage access key ID.
STORAGE_S3_ACCESS_KEY_ID=
# S3-compatible storage secret access key.
STORAGE_S3_SECRET_ACCESS_KEY=

# SEC EDGAR identifying user agent, including a monitored contact address.
SEC_USER_AGENT=

# Deployment mode; preview is the safe pre-launch mode.
SITE_MODE=
# Canonical public site URL.
SITE_URL=
# HMAC secret for internal revalidation requests.
REVALIDATE_SECRET=
# Basic-auth username used to protect preview pages.
PREVIEW_AUTH_USERNAME=
# Basic-auth password used to protect preview pages.
PREVIEW_AUTH_PASSWORD=
