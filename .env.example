# db
# Optional for the app; required for workspace/CI migrations only.
DATABASE_URL_MIGRATIONS=
# Required: RLS-limited public database connection.
DATABASE_URL_PUBLIC=
# Required: app and jobs database connection.
DATABASE_URL_APP=
# Test-only: disposable plain PostgreSQL 17 on loopback, NEVER Supabase (D-78).
# Remove/unset this entry to use db:test:up's local default; see the database handoff.
DATABASE_URL_TEST=

# auth
# Required: Supabase authentication project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Required: browser-safe Supabase anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Workspace shell CLI only; NEVER configure in application/deployment environments (D-48).
SUPABASE_SECRET_KEY=

# sec
# Required: SEC EDGAR identifying user agent and contact address.
SEC_USER_AGENT=

# storage
# Required: S3-compatible API endpoint.
S3_ENDPOINT=
# Required: S3 region.
S3_REGION=
# Required: S3 access key ID.
S3_ACCESS_KEY_ID=
# Required: S3 secret access key.
S3_SECRET_ACCESS_KEY=
# Required: public media bucket.
S3_BUCKET_PUBLIC=
# Required: public media base URL.
PUBLIC_MEDIA_BASE_URL=

# site
# Required: canonical site URL.
SITE_URL=
# Optional: preview or live; defaults to preview.
SITE_MODE=
# Required in preview; optional in live: basic-auth username.
PREVIEW_BASIC_AUTH_USER=
# Required in preview; optional in live: basic-auth password.
PREVIEW_BASIC_AUTH_PASSWORD=

# jobs
# Optional: positive integer batch size; defaults to 100.
JOB_BATCH_SIZE=

# Later (D-54)
# Deferred: Anthropic API credential.
# ANTHROPIC_API_KEY=
# Deferred: explanation model ID.
# LLM_MODEL=
# Deferred: internal revalidation HMAC credential.
# REVALIDATE_SECRET=
# Deferred: archive bucket.
# S3_BUCKET_ARCHIVE=
# Deferred: OTP hook signing credential.
# SEND_OTP_HOOK_SECRET=
